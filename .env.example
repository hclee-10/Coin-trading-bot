# .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
# 사용하는 거래소의 블록만 채우면 됩니다.

# 어느 거래소든 "거래" 권한만 켜고, "출금"은 절대 켜지 마세요.

# --- Bitget ---
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- Gate.io ---
# Gate 는 패스프레이즈가 없습니다. 키와 시크릿 두 개만 넣으세요.
GATE_API_KEY=
GATE_API_SECRET=

# --- OKX ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- 웹 대시보드 ---
WEB_USERNAME=

# 비밀번호는 둘 중 하나만 채우세요.
#
# (A) 간단한 방법 — 비밀번호를 그대로 넣습니다. 서버가 기동할 때 해시로 바꿉니다.
WEB_PASSWORD=
#
# (B) 비밀번호를 평문으로 두기 싫을 때 — `python -m bot hash-password` 의 출력을
#     넣습니다. 다른 곳에서도 쓰는 비밀번호라면 이쪽을 권합니다.
#     둘 다 있으면 이쪽이 우선합니다.
# WEB_PASSWORD_HASH=

# 2단계 인증 (선택, 강력 권장)
# `python -m bot setup-2fa` 로 QR 을 만들어 인증 앱에 등록한 뒤 키를 넣으세요.
# 값이 없으면 2단계 인증 없이 아이디·비밀번호만으로 로그인합니다.
WEB_TOTP_SECRET=
