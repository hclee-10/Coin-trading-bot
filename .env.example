# .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
# 사용하는 거래소의 블록만 채우면 됩니다.

# --- OKX ---
# API 관리에서 "거래" 권한만 켜고, "출금"은 절대 켜지 마세요. IP 화이트리스트 권장.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- Bitget ---
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- 웹 대시보드 ---
# `python -m bot hash-password` 의 출력을 그대로 붙여 넣으세요.
# 비밀번호 원문이 아니라 scrypt$... 로 시작하는 해시여야 합니다.
WEB_PASSWORD_HASH=
