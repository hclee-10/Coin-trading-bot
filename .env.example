# .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
# 사용하는 거래소의 블록만 채우면 됩니다.

# 어느 거래소든 "거래" 권한만 켜고, "출금"은 절대 켜지 마세요.

# --- Bitget ---
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- Gate.io ---
# Gate 는 패스프레이즈가 없습니다. 키와 시크릿 두 개만 넣으세요.
GATE_API_KEY=
GATE_API_SECRET=

# --- OKX ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- 웹 대시보드 ---
# `python -m bot hash-password` 의 출력 두 줄을 그대로 붙여 넣으세요.
# WEB_PASSWORD_HASH 는 비밀번호 원문이 아니라 scrypt$... 로 시작하는 해시입니다.
WEB_USERNAME=
WEB_PASSWORD_HASH=
